# /etc/rob20/oracle.env  — root-only (chmod 600, chown root:root)
# Dedicated LOW-VALUE hot wallet: it only pays gas to call confirm()/settleBid().
# Never put the platform-owner (fee) key here.
ORACLE_PRIVATE_KEY=0xyour_oracle_hot_wallet_private_key
# Optional: override the RPC (keep the dRPC key out of the repo config)
# RPC_URL=https://lb.drpc.live/robinhood/xxxx
