# systemd unit — rob-20 indexer (accounting authority). Runs 24/7, auto-restart.
# Install: sudo cp ops/rob20-indexer.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now rob20-indexer
# Logs:    journalctl -u rob20-indexer -f
[Unit]
Description=rob-20 inscription indexer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rob20
WorkingDirectory=/opt/rob20
# CONFIG_PATH points at the production config (mainnet RPC + contract addresses).
# RPC_URL can override the config's rpcUrl (keep the dRPC key out of the repo).
Environment=CONFIG_PATH=/opt/rob20/indexer/config.production.json
EnvironmentFile=-/etc/rob20/indexer.env
ExecStart=/usr/bin/node /opt/rob20/indexer/indexer.mjs
Restart=always
RestartSec=3
# The indexer halts (exit 1) on a reorg or over-mint — restart, then a human
# follows the runbook (ops/README.md) if it keeps exiting.
StartLimitIntervalSec=60
StartLimitBurst=10
# hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/rob20/indexer
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
